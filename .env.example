# ── Base de données ───────────────────────────────────────
DB_USER=stage_user
DB_PASSWORD=stage_password
DATABASE_URL=postgresql+asyncpg://stage_user:stage_password@db:5432/stage_crm

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── API Claude (Anthropic) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── Gmail API ─────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# ── Scraping ──────────────────────────────────────────────
SCRAPING_INTERVAL_HOURS=24
MAX_OFFERS_PER_SCAN=100

# ── App ───────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Welcome to the Jungle (Algolia, recherche) ────────────
WTTJ_ALGOLIA_APP_ID=
WTTJ_ALGOLIA_API_KEY=

# ── Profil (utilisé dans les prompts IA) ──────────────────
USER_EDUCATION=
