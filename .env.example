# ══════════════════════════════════════════════════════════
# Stage CRM — modèle de configuration
#
# Copier ce fichier en `.env` (`cp .env.example .env`) puis adapter
# si besoin. Les valeurs ci-dessous fonctionnent telles quelles en
# local : aucune modification n'est nécessaire pour un premier
# lancement.
#
# ⚠️ `.env` est ignoré par git (voir .gitignore) : il ne doit JAMAIS
#    être versionné. Ce fichier-ci ne contient aucun secret réel.
# ══════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ────────────────────────────
# Identifiants du conteneur `db`. Ils sont utilisés à la fois pour
# initialiser Postgres et pour construire DATABASE_URL côté backend.
# Sur une instance locale non exposée à Internet, les valeurs par
# défaut suffisent ; change le mot de passe si tu exposes le port.
DB_NAME=stage_crm
DB_USER=stage_user
DB_PASSWORD=change_me_local_only

# URL SQLAlchemy async utilisée par le backend et par Alembic.
# En Docker Compose, cette valeur est REDÉFINIE automatiquement par
# docker-compose.yml (hôte `db`, port interne 5432). Elle ne sert donc
# qu'en exécution hors conteneur (venv local, tests manuels).
DATABASE_URL=postgresql+asyncpg://stage_user:change_me_local_only@localhost:5432/stage_crm

# Optionnel — surcharge d'URL utilisée UNIQUEMENT par Alembic
# (`backend/alembic/env.py`). Utile pour migrer une autre base sans
# toucher à DATABASE_URL. Laisser vide/commenté dans le cas normal.
# ALEMBIC_DATABASE_URL=

# ── Ports publiés sur la machine hôte ─────────────────────
# À changer si un de ces ports est déjà pris (autre Postgres local,
# autre projet Next.js…). Le port INTERNE des conteneurs ne bouge pas.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Application ───────────────────────────────────────────
# `development` active les logs SQL (echo) ; mettre `production`
# pour les couper.
APP_ENV=development

# Origine autorisée par le CORS du backend. Doit correspondre à
# l'URL à laquelle tu ouvres le frontend dans ton navigateur.
FRONTEND_URL=http://localhost:3000

# URL de l'API appelée depuis le NAVIGATEUR (donc port hôte, pas
# le nom de service Docker). Laisser commenté : docker-compose la
# déduit de BACKEND_PORT. À définir seulement si tu exposes l'API
# derrière un reverse proxy ou un autre nom d'hôte.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Uploads (PDF de CV / lettres de motivation) ────────────
# Chemin DANS le conteneur backend. Il est monté sur le volume Docker
# nommé `user_uploads` : tes PDF restent sur ta machine et ne sont
# jamais versionnés.
UPLOAD_DIR=/app/uploads

# Taille maximale d'un PDF uploadé, en octets (10 Mo par défaut).
MAX_UPLOAD_BYTES=10485760
